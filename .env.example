# Copy to .env locally; never commit the real .env.
# Load it explicitly before running: set -a; source .env; set +a
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace-with-your-model
# Optional Azure configuration:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=replace-with-your-key
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Optional memory backend override:
# HSGM_MEMORY_BACKEND=local

